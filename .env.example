# Copy this file to .env. Only the machine running the server needs it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx

# AI assistant (Special Point). Get a free key at https://aistudio.google.com/apikey
# Without it the chat still works and the AI only says it is not set up.
GEMINI_API_KEY=
# Optional: the models to try, in order, comma separated. When one is out of free quota the next
# one answers. Default: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_MODELS=
