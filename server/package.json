{
  "name": "@chat/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "check:db": "tsx --env-file-if-exists=../.env src/check-db.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --env-file-if-exists=../.env --test test/*.test.ts"
  },
  "dependencies": {
    "@chat/shared": "*",
    "@supabase/supabase-js": "^2.119.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
