{
  "name": "socket-chat",
  "private": true,
  "version": "0.1.0",
  "description": "LINE-style chat web application for the Computer Network term project",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "start:server": "npm run start -w server",
    "build:client": "npm run build -w client",
    "check:db": "npm run check:db -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server"
  }
}
